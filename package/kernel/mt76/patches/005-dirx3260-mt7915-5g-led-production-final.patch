diff --git a/mt7915/mcu.c b/mt7915/mcu.c
--- a/mt7915/mcu.c
+++ b/mt7915/mcu.c
@@ -4203,3 +4203,69 @@
 
 	return 0;
 }
+
+/*
+ * DIR-X3260 A1 MT7915 5 GHz LED MCU backend.
+ *
+ * Runtime-verified OEM commands:
+ *   op 0 = LED source map
+ *   op 1 = CONTROL=0 / OFF
+ *   op 2 = OEM LED enhance configuration
+ *   op 3 = CONTROL=1 / ON
+ *
+ * The board-specific callers initialize the LED map after MCU
+ * startup and replay CONTROL=1 after successful AP startup.
+ */
+int mt7915_mcu_dirx3260_led_oem(struct mt7915_dev *dev, u8 op)
+{
+static const u8 map_req[8] = {
+0x02, 0x05, 0x01, 0x00,
+0x00, 0x34, 0x00, 0x00,
+};
+static const u8 op1_req[8] = {
+0x02, 0x01, 0x01, 0x00,
+0x00, 0x00, 0x00, 0x00,
+};
+static const u8 op2_req[20] = {
+0x02, 0x02, 0x01, 0x00,
+0x00, 0x00, 0x00, 0x00,
+0x00, 0x02, 0x00, 0x00,
+0x46, 0x00, 0x1e, 0x00,
+0x00, 0x00, 0x00, 0x00,
+};
+static const u8 op1_control1_req[8] = {
+0x02, 0x01, 0x01, 0x01,
+0x00, 0x00, 0x00, 0x00,
+};
+
+const void *req;
+size_t len;
+int cmd;
+
+switch (op) {
+case 0:
+req = map_req;
+len = sizeof(map_req);
+break;
+case 1:
+req = op1_req;
+len = sizeof(op1_req);
+break;
+case 2:
+req = op2_req;
+len = sizeof(op2_req);
+break;
+case 3:
+req = op1_control1_req;
+len = sizeof(op1_control1_req);
+break;
+default:
+return -EINVAL;
+}
+
+cmd = MCU_CMD(EXT_CID) |
+      FIELD_PREP(__MCU_CMD_FIELD_EXT_ID, 0x17);
+
+return mt76_mcu_send_msg(&dev->mt76, cmd, req, len, true);
+}
+
