+struct mt76_phy *mphy;
+struct mt7915_dev *dev;
+
+mphy = container_of(led_cdev, struct mt76_phy, leds.cdev);
+dev = container_of(mphy->dev, struct mt7915_dev, mt76);
+
+/*
+ * DIR-X3260 A1 MT7915 5 GHz LED.
+ *
+ * The DIR-X3260 DTS uses led-sources = <26>.
+ * OEM firmware routes source 26 through the MT7915 MCU LED engine.
+ *
+ * Runtime verified:
+ *   op 1 = CONTROL=0 = OFF
+ *   op 3 = CONTROL=1 = ON
+ */
+if (is_mt7915(&dev->mt76) &&
+    mphy == &dev->mt76.phy &&
+    mt7915_is_dirx3260()) {
+mt7915_mcu_dirx3260_led_oem(dev, brightness ? 3 : 1);
+return;
+}
+
+if (!brightness)
+mt7915_led_set_config(led_cdev, 0, 0xff);
+else
+mt7915_led_set_config(led_cdev, 0xff, 0);
 }
 
